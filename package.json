{
  "name": "kini",
  "version": "0.2.0",
  "private": true,
  "description": "Kini football pool platform monorepo",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=10"
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "prepare": "node ./scripts/prepare-husky.mjs",
    "lint": "npm run lint --workspaces --if-present",
    "format": "prettier --write \".github/**/*.{yml,yaml}\" \"docker/**/*.{yml,yaml}\" \"docs/**/*.md\" \"scripts/**/*.mjs\" \"apps/ui/tolgee.config.cjs\" \"apps/ui/messages/*.json\" \"README.md\" \"package.json\" \".release-please-config.json\" \".release-please-manifest.json\"",
    "format:check": "prettier --check \".github/**/*.{yml,yaml}\" \"docker/**/*.{yml,yaml}\" \"docs/**/*.md\" \"scripts/**/*.mjs\" \"apps/ui/tolgee.config.cjs\" \"apps/ui/messages/*.json\" \"README.md\" \"package.json\" \".release-please-config.json\" \".release-please-manifest.json\"",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:cov:api": "npm run test:cov -w @kini/api -- --passWithNoTests",
    "test:secrets:gitleaks": "./scripts/precommit-gitleaks.sh",
    "ci:quality:local": "npm run lint && npm run typecheck && npm run build && npm run test:cov:api && npm run test -w @kini/web",
    "precommit:checks": "npm run test:secrets:gitleaks && npm run ci:quality:local",
    "i18n:push:local": "node scripts/i18n-sync-local.mjs --once --workspace @kini/web",
    "i18n:watch:local": "node scripts/i18n-sync-local.mjs --watch --workspace @kini/web",
    "local:token": "bash ../platform-ops/scripts/provision-local-app-token.sh kini",
    "local:up": "bash ./scripts/local-stack-up.sh",
    "local:down": "bash ./scripts/local-stack-down.sh",
    "local:reset": "bash ./scripts/local-stack-reset.sh",
    "audit": "npm audit --audit-level=high",
    "clean": "npm run clean --workspaces --if-present && rm -rf node_modules",
    "audit:prod:gate": "node ./scripts/audit-prod-gate.mjs",
    "contract:gen:web": "node ./scripts/generate-api-contract.mjs"
  },
  "overrides": {
    "@nestjs/common": "11.2.3",
    "@nestjs/core": "11.2.3",
    "postcss": "8.5.24",
    "gaxios": "7.3.0",
    "multer": "2.2.0",
    "@nestjs/platform-express": {
      "multer": "2.2.0"
    },
    "ioredis": "5.9.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.4.2",
    "@commitlint/config-conventional": "^20.4.2",
    "@types/node": "^20.10.0",
    "husky": "^9.1.7",
    "prettier": "^3.1.0",
    "typescript": "^5.3.0"
  }
}
