{
  "name": "@kini/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 3001",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0 --port 3001",
    "lint": "next lint --no-cache",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "sonar:scan": "sonar-scanner -Dsonar.token=${SONAR_TOKEN}",
    "i18n:pull": "tolgee pull --config ./tolgee.config.cjs",
    "i18n:push": "tolgee push --config ./tolgee.config.cjs --force-mode OVERRIDE",
    "clean": "rm -rf .next coverage"
  },
  "dependencies": {
    "next": "^15.5.18",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@tolgee/cli": "2.16.1",
    "@types/node": "^20.17.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.10",
    "sonarqube-scanner": "^4.3.2",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
