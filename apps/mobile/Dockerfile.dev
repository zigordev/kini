# Use Node.js 20 Alpine for compatibility with React Native and Expo
FROM node:20-alpine

# Set working directory
WORKDIR /app

# Install Expo CLI globally
RUN npm install -g @expo/cli

# Copy package files
COPY package*.json ./

# Install dependencies
RUN npm install

# Copy the rest of the application
COPY . .


# Expose the default Expo development server port
EXPOSE 8081

# Expose the Metro bundler port for hot reloading
EXPOSE 19000
EXPOSE 19001
EXPOSE 19002

# Start the Expo development server directly with proper configuration
CMD ["sh", "-c", "EXPO_DEVTOOLS_LISTEN_ADDRESS=0.0.0.0 REACT_NATIVE_PACKAGER_HOSTNAME=0.0.0.0 npx expo start --web --host localhost --port 8081"]
