{
  "name": "@kini/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 3001",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0 --port 3001",
    "lint": "eslint --no-cache .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "i18n:pull": "tolgee pull --config ./tolgee.config.cjs",
    "i18n:push": "tolgee push --config ./tolgee.config.cjs --force-mode OVERRIDE",
    "clean": "rm -rf .next coverage",
    "e2e": "playwright test"
  },
  "dependencies": {
    "design-system": "github:zigordev/design-system#v0.1.46",
    "jszip": "^3.10.1",
    "next": "^16.3.4",
    "prom-client": "^15.1.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@tolgee/cli": "2.20.0",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.5",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.2",
    "vitest": "^5.0.0"
  }
}
