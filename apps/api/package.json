{
  "name": "@kini/api",
  "version": "0.1.0",
  "description": "Kini NestJS API",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "lint:fix": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest --watchman=false",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "docker:build": "docker build -f Dockerfile -t kini-api:local ../..",
    "trivy:scan": "docker run --rm -v $(pwd):/project:ro -v $(pwd)/../../infra/monitoring/trivy-reports:/reports aquasec/trivy:0.56.2 fs --scanners vuln,secret --include-dev-deps --format json --output /reports/kini-api.trivy.json /project && node ../../infra/monitoring/trivy-json-to-ndjson.js ../../infra/monitoring/trivy-reports/kini-api.trivy.json ../../infra/monitoring/trivy-reports/kini-api-trivy.ndjson kini-api && node ../../infra/monitoring/npm-audit-to-ndjson.js . ../../infra/monitoring/trivy-reports/kini-api-npm.ndjson kini-api",
    "trivy:scan:image": "npm run docker:build && docker run --rm -v /var/run/docker.sock:/var/run/docker.sock -v $(pwd)/../../infra/monitoring/trivy-reports:/reports aquasec/trivy:0.56.2 image --scanners vuln,secret --format template --template '{{range .Results}}{{$t:=.Target}}{{range .Vulnerabilities}}{\"project\":\"kini-api\",\"Target\":\"{{$t}}\",\"Class\":\"vuln\",\"Severity\":\"{{.Severity}}\",\"VulnerabilityID\":\"{{.VulnerabilityID}}\",\"PkgName\":\"{{.PkgName}}\",\"InstalledVersion\":\"{{.InstalledVersion}}\",\"FixedVersion\":\"{{.FixedVersion}}\",\"Title\":\"{{.Title}}\",\"PrimaryURL\":\"{{.PrimaryURL}}\"}{{\"\\n\"}}{{end}}{{range .Secrets}}{\"project\":\"kini-api\",\"Target\":\"{{$t}}\",\"Class\":\"secret\",\"Severity\":\"{{.Severity}}\",\"RuleID\":\"{{.RuleID}}\",\"Category\":\"{{.Category}}\",\"Match\":\"{{.Match}}\"}{{\"\\n\"}}{{end}}{{end}}' --output /reports/kini-api.ndjson kini-api:local",
    "sonar:scan": "sonar-scanner -Dsonar.token=${SONAR_TOKEN}",
    "sonar:install": "npm install -D sonarqube-scanner"
  },
  "dependencies": {
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^3.0.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/passport": "^10.0.0",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/platform-socket.io": "^10.0.0",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^7.1.19",
    "@nestjs/typeorm": "^10.0.0",
    "@nestjs/websockets": "^10.0.0",
    "@types/pdf-parse": "^1.1.4",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "cookie-parser": "^1.4.7",
    "express-session": "^1.17.3",
    "fast-xml-parser": "^5.9.3",
    "helmet": "^8.3.0",
    "kafkajs": "^2.2.4",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "pdf-parse": "^1.1.1",
    "pg": "^8.11.3",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.1",
    "socket.io": "^4.7.5",
    "swagger-ui-express": "^5.0.0",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@types/express": "^4.17.17",
    "@types/express-session": "^1.17.10",
    "@types/jest": "^29.5.2",
    "@types/node": "^20.3.1",
    "@types/passport": "^1.0.16",
    "@types/passport-google-oauth20": "^2.0.15",
    "@types/supertest": "^6.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^8.42.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "jest": "^29.5.0",
    "prettier": "^3.0.0",
    "sonarqube-scanner": "^4.3.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.0",
    "ts-loader": "^9.4.3",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.1.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^src/(.*)$": "<rootDir>/$1"
    }
  }
}
