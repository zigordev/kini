#RUNTIME
AUTH_CORS_ORIGINS=https://CHANGE_ME_kini.zigordev.com
AUTH_SUCCESS_REDIRECT_URL=https://CHANGE_ME_kini.zigordev.com/auth/callback
AUTH_FAILURE_REDIRECT_URL=https://CHANGE_ME_kini.zigordev.com/login

#GOOGLE_OAUTH
GOOGLE_CLIENT_ID=CHANGE_ME_REGISTER_GOOGLE_OAUTH_APP
GOOGLE_CALLBACK_URL=https://CHANGE_ME_kini-api.zigordev.com/auth/google/callback

#NOTIFICATIONS
NOTIFICATIONS_KAFKA_BROKERS=platform-redpanda:9092
NOTIFICATIONS_EMAIL_TOPIC=notification.email.requested.v1

#WEB_BUILD
NEXT_PUBLIC_API_BASE_URL=https://CHANGE_ME_kini-api.zigordev.com
NEXT_PUBLIC_RELEASE=bootstrap

#DEPLOY_IMAGES
API_IMAGE=REQUIRED_SET_BY_DEPLOY
WEB_IMAGE=REQUIRED_SET_BY_DEPLOY

#FRONTEND
FRONTEND_URL=https://CHANGE_ME_kini.zigordev.com
